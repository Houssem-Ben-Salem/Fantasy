__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.DS_Store

# Rebuildable in ~30s via `make ingest`; 12 MB of binary that git cannot
# delta-compress. Never commit it — the CI workflow uploads it as an artifact
# and commits the projections CSV instead.
data/cache/
data/*.db
data/*.db-wal
data/*.db-shm

# generated by analysis/watch_squad.py
analysis/squad_watch.log

# Newsletters are third-party content, and the xMins log is a local research
# record. Nothing under data/ is versioned (the DB, the cache, these).
data/newsletters/

# The tracker's files hold the manager's squad and season (scripts/build_tracker.py).
data/tracker/
